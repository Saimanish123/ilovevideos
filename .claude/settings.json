{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx biome *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(ffprobe *)",
      "Bash(ffmpeg -i *)"
    ],
    "deny": ["Bash(rm -rf /*)", "Bash(git push --force*)", "Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(cat | jq -r '.tool_input.file_path // empty'); case \"$f\" in *.ts|*.tsx|*.json|*.css) cd \"$CLAUDE_PROJECT_DIR\" && ./node_modules/.bin/biome check --write \"$f\" >/dev/null 2>&1 || true;; esac"
          }
        ]
      }
    ]
  }
}
