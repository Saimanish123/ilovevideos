# Public site URL used for canonical links, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Working product name; single source of truth for the brand string (see ADR-0001)
NEXT_PUBLIC_SITE_NAME=ilovevideos
# Optional: server-fallback processing endpoint (leave empty to disable the server path entirely)
PROCESSING_SERVER_URL=
